function(invoke name expected)
    execute_process(COMMAND "${TOOL}" ${ARGN} RESULT_VARIABLE _exit
        OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr ENCODING UTF-8 TIMEOUT 15)
    file(WRITE "${_run}/${name}.stdout.json" "${_stdout}")
    file(WRITE "${_run}/${name}.stderr.json" "${_stderr}")
    if(NOT "${_exit}" STREQUAL "${expected}")
        message(FATAL_ERROR "${name}: unexpected exit ${_exit}; ${_stderr}; ${_run}")
    endif()
    if(expected EQUAL 0)
        string(JSON _status GET "${_stdout}" status)
        if(NOT _status STREQUAL "passed")
            message(FATAL_ERROR "${name}: invalid success receipt")
        endif()
        set(${name} "${_stdout}" PARENT_SCOPE)
    else()
        string(JSON _status GET "${_stderr}" status)
        string(JSON _error GET "${_stderr}" error)
        if(NOT _status STREQUAL "failed" OR _error STREQUAL "")
            message(FATAL_ERROR "${name}: missing explicit failure diagnostic")
        endif()
    endif()
endfunction()
