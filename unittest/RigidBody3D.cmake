if(NOT DEFINED _det_character_library)
    set(_det_character_library AYEntityDeterminism)
endif()
get_filename_component(_rigid3d_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
foreach(_pair "RigidBody3D|rigidbody3d" "Float64State|float64state")
    string(REPLACE "|" ";" _parts "${_pair}")
    list(GET _parts 0 _name)
    list(GET _parts 1 _file)
    add_executable(AYEntity_${_name}Checks "${_rigid3d_root}/unittest/portable/${_file}.cpp")
    target_link_libraries(AYEntity_${_name}Checks PRIVATE ${_det_character_library})
    target_compile_features(AYEntity_${_name}Checks PRIVATE cxx_std_23)
    if(MSVC)
        target_compile_options(AYEntity_${_name}Checks PRIVATE /utf-8)
    endif()
    add_test(NAME AYEntity_${_name}Checks COMMAND AYEntity_${_name}Checks)
    set_tests_properties(AYEntity_${_name}Checks PROPERTIES TIMEOUT 120 LABELS "ayentity;determinism;rigid3d;numeric")
endforeach()
