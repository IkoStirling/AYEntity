function(path_contains data literal)
    string(FIND "${data}" "${literal}" _pathFound)
    if(_pathFound LESS 0)
        message(FATAL_ERROR "Missing independent path-authoring literal: ${literal}")
    endif()
endfunction()
function(path_nonmotion_lines source output)
    file(STRINGS "${source}" _pathLines)
    set(_pathOther "")
    foreach(_pathLine IN LISTS _pathLines)
        if(NOT _pathLine MATCHES "^(paths |path |point |actors |actor )")
            list(APPEND _pathOther "${_pathLine}")
        endif()
    endforeach()
    set(${output} "${_pathOther}" PARENT_SCOPE)
endfunction()
function(path_actor_index receipt id output)
    string(JSON _pathActorCount GET "${receipt}" actorCount)
    math(EXPR _pathLastActor "${_pathActorCount}-1")
    foreach(_pathIndex RANGE 0 ${_pathLastActor})
        string(JSON _pathActorId GET "${receipt}" actors ${_pathIndex} id)
        if(_pathActorId STREQUAL id)
            set(${output} ${_pathIndex} PARENT_SCOPE)
            return()
        endif()
    endforeach()
    message(FATAL_ERROR "Missing authored actor ${id}")
endfunction()
