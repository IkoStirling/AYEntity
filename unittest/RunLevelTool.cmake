function(remove_compare before after removed beforeFile afterFile)
    string(JSON _removeBeforeCount GET "${before}" actorCount)
    string(JSON _removeAfterCount GET "${after}" actorCount)
    math(EXPR _removeExpectedCount "${_removeBeforeCount}-1")
    if(NOT _removeAfterCount EQUAL _removeExpectedCount)
        message(FATAL_ERROR "remove-solid did not remove exactly one actor")
    endif()
    set(_removeNext 0)
    math(EXPR _removeLast "${_removeBeforeCount}-1")
    foreach(_removeIndex RANGE 0 ${_removeLast})
        string(JSON _removeId GET "${before}" actors ${_removeIndex} id)
        if(NOT _removeId STREQUAL removed)
            string(JSON _removeOld GET "${before}" actors ${_removeIndex})
            string(JSON _removeNew GET "${after}" actors ${_removeNext})
            if(NOT _removeOld STREQUAL _removeNew)
                message(FATAL_ERROR "remove-solid changed an unselected complete actor")
            endif()
            math(EXPR _removeNext "${_removeNext}+1")
        endif()
    endforeach()
    solid_nonactor_lines("${beforeFile}" _removeOldPolicy)
    solid_nonactor_lines("${afterFile}" _removeNewPolicy)
    if(NOT _removeOldPolicy STREQUAL _removeNewPolicy)
        message(FATAL_ERROR "remove-solid changed complete immutable policy/version/authority tables")
    endif()
    string(JSON _removeOldHash GET "${before}" contentHash)
    string(JSON _removeNewHash GET "${after}" contentHash)
    if(_removeOldHash STREQUAL _removeNewHash)
        message(FATAL_ERROR "Actual actor removal did not change complete content identity")
    endif()
endfunction()
