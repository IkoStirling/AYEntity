# Stage69: only Live128+real restore97 suffix and Record128. No authoring CLI or old six-path matrix.
foreach(_input EXAMPLE LEVEL)
    if(NOT DEFINED ${_input} OR NOT EXISTS "${${_input}}" OR IS_DIRECTORY "${${_input}}" OR IS_SYMLINK "${${_input}}")
        message(FATAL_ERROR "${_input} must be an ordinary existing file")
    endif()
endforeach()
if(NOT DEFINED OUTPUT_DIR)
    message(FATAL_ERROR "OUTPUT_DIR required")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
string(TIMESTAMP _stamp "%Y%m%dT%H%M%S" UTC)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef _nonce)
set(_run "${OUTPUT_DIR}/run-${_stamp}-${_nonce}")
if(EXISTS "${_run}")
    message(FATAL_ERROR "Fresh challenge directory exists")
endif()
file(MAKE_DIRECTORY "${_run}")
function(run_challenge name)
    execute_process(COMMAND "${EXAMPLE}" --scenario challenge --level "${LEVEL}" --ticks 128 --require-features
        --output "${_run}/${name}" ${ARGN}
        RESULT_VARIABLE _exit OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr ENCODING UTF-8 TIMEOUT 25)
    file(WRITE "${_run}/${name}.stdout.txt" "${_stdout}")
    file(WRITE "${_run}/${name}.stderr.txt" "${_stderr}")
    file(WRITE "${_run}/${name}.exit.txt" "${_exit}\n")
    if(NOT "${_exit}" STREQUAL "0")
        message(FATAL_ERROR "Challenge ${name} failed (${_exit}); ${_run}\n${_stderr}")
    endif()
endfunction()
run_challenge(live --verify-restore)
run_challenge(record --record "${_run}/challenge.rpl")
foreach(_name live record)
    foreach(_suffix state trace summary.json boundary97.state)
        if(NOT EXISTS "${_run}/${_name}.${_suffix}" OR IS_DIRECTORY "${_run}/${_name}.${_suffix}" OR IS_SYMLINK "${_run}/${_name}.${_suffix}")
            message(FATAL_ERROR "Missing ordinary ${_name} ${_suffix}")
        endif()
        file(SIZE "${_run}/${_name}.${_suffix}" _size)
        if(_size LESS 1)
            message(FATAL_ERROR "Empty ${_name} ${_suffix}")
        endif()
    endforeach()
    file(READ "${_run}/${_name}.summary.json" _summary)
    foreach(_field schema status scenario mode nextTick traceRows inputCallbacks originalInputCallbacks advanceCalls restoreBoundary restoreCPComparisons featureChecks inputPayloadBytes levelProfile brainProfile gateMask actionAttempts pickupMask counter objectiveSatisfied claimed claimTick flowClaimAttempts flowClaimCode flowClaimActionSequence flowObjectiveAttempts flowObjectiveCode flowObjectiveActionSequence onceConsumed manualDoorAllowed)
        string(JSON _${_field} GET "${_summary}" "${_field}")
    endforeach()
    set(_calls 128)
    set(_advances 128)
    set(_restoreBoundary 0)
    set(_restoreRows 0)
    if(_name STREQUAL "live")
        set(_calls 159)
        set(_advances 159)
        set(_restoreBoundary 97)
        set(_restoreRows 31)
    endif()
    if(NOT _schema STREQUAL "1" OR NOT _status STREQUAL "passed" OR NOT _scenario STREQUAL "challenge" OR NOT _mode STREQUAL "${_name}"
        OR NOT _nextTick STREQUAL "128" OR NOT _traceRows STREQUAL "128" OR NOT _originalInputCallbacks STREQUAL "128"
        OR NOT _inputCallbacks STREQUAL "${_calls}" OR NOT _advanceCalls STREQUAL "${_advances}"
        OR NOT _restoreBoundary STREQUAL "${_restoreBoundary}" OR NOT _restoreCPComparisons STREQUAL "${_restoreRows}"
        OR NOT _featureChecks STREQUAL "ON" OR NOT _inputPayloadBytes STREQUAL "9" OR NOT _levelProfile STREQUAL "11"
        OR NOT _brainProfile STREQUAL "2" OR NOT _gateMask STREQUAL "0" OR NOT _actionAttempts STREQUAL "2"
        OR NOT _pickupMask STREQUAL "0" OR NOT _counter STREQUAL "1" OR NOT _objectiveSatisfied STREQUAL "ON"
        OR NOT _claimed STREQUAL "ON" OR NOT _claimTick STREQUAL "97" OR NOT _flowClaimAttempts STREQUAL "1"
        OR NOT _flowClaimCode STREQUAL "1" OR NOT _flowClaimActionSequence STREQUAL "1"
        OR NOT _flowObjectiveAttempts STREQUAL "1" OR NOT _flowObjectiveCode STREQUAL "1"
        OR NOT _flowObjectiveActionSequence STREQUAL "2" OR NOT _onceConsumed STREQUAL "ON" OR NOT _manualDoorAllowed STREQUAL "OFF")
        message(FATAL_ERROR "${_name} actual challenge lifecycle summary mismatch; ${_run}")
    endif()
    file(STRINGS "${_run}/${_name}.trace" _rows)
    list(LENGTH _rows _length)
    if(NOT _length EQUAL 128)
        message(FATAL_ERROR "${_name} original trace length")
    endif()
endforeach()
file(READ "${_run}/live.boundary97.state" _pendingLive HEX)
file(READ "${_run}/record.boundary97.state" _pendingRecord HEX)
if(NOT _pendingLive STREQUAL _pendingRecord)
    message(FATAL_ERROR "Challenge actual CP97 pending-event bytes differ between Live/Record")
endif()
file(SHA256 "${_run}/live.state" _liveState)
file(SHA256 "${_run}/record.state" _recordState)
file(SHA256 "${_run}/live.restore.state" _restoredState)
if(NOT _liveState STREQUAL _recordState OR NOT _liveState STREQUAL _restoredState)
    message(FATAL_ERROR "Challenge final complete checkpoint bytes differ")
endif()
file(READ "${_run}/live.state" _liveBytes HEX)
file(READ "${_run}/record.state" _recordBytesExact HEX)
file(READ "${_run}/live.restore.state" _restoredBytesExact HEX)
if(NOT _liveBytes STREQUAL _recordBytesExact OR NOT _liveBytes STREQUAL _restoredBytesExact)
    message(FATAL_ERROR "Challenge actual final checkpoint byte comparison differs")
endif()
file(READ "${_run}/live.trace" _liveTrace)
file(READ "${_run}/record.trace" _recordTrace)
if(NOT _liveTrace STREQUAL _recordTrace)
    message(FATAL_ERROR "Challenge Live/Record original per-tick hashes differ")
endif()
file(STRINGS "${_run}/live.trace" _liveRows)
list(SUBLIST _liveRows 97 31 _suffix)
file(STRINGS "${_run}/live.restore.trace" _restoredRows)
if(NOT _suffix STREQUAL _restoredRows)
    message(FATAL_ERROR "Real Live restore97 suffix differs")
endif()
file(READ "${_run}/record.summary.json" _recordSummary)
string(JSON _recording GET "${_recordSummary}" recordingPath)
if(NOT EXISTS "${_recording}" OR IS_DIRECTORY "${_recording}" OR IS_SYMLINK "${_recording}")
    message(FATAL_ERROR "Record did not close a real ordinary recordingPath")
endif()
file(SIZE "${_recording}" _recordBytes)
if(_recordBytes LESS 1)
    message(FATAL_ERROR "Empty actual record")
endif()
message(STATUS "Challenge: actual collectible -> counter -> objective -> two Actions; Live128+31restore fullCP suffix and Record128 agree; artifacts ${_run}. Record existence is not playback/authentication.")
