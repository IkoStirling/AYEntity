foreach(_input TOOL LEVEL1 LEVEL2 LEVEL3 LEVEL4 LEVEL5 LEVEL6 LEVEL7)
    if(NOT DEFINED ${_input} OR NOT EXISTS "${${_input}}" OR IS_DIRECTORY "${${_input}}" OR IS_SYMLINK "${${_input}}")
        message(FATAL_ERROR "${_input} must be an ordinary existing file")
    endif()
endforeach()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
string(TIMESTAMP _stamp "%Y%m%dT%H%M%S" UTC)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef _nonce)
set(_run "${OUTPUT_DIR}/run-${_stamp}-${_nonce}")
if(EXISTS "${_run}")
    message(FATAL_ERROR "Artifact path must be fresh")
endif()
file(MAKE_DIRECTORY "${_run}")
function(invoke name expected)
    execute_process(COMMAND "${TOOL}" ${ARGN} RESULT_VARIABLE _exit
        OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr ENCODING UTF-8 TIMEOUT 15)
    file(WRITE "${_run}/${name}.stdout.json" "${_stdout}")
    file(WRITE "${_run}/${name}.stderr.json" "${_stderr}")
    if(NOT "${_exit}" STREQUAL "${expected}")
        message(FATAL_ERROR "${name}: unexpected exit ${_exit}; ${_stderr}; ${_run}")
    endif()
    if(expected EQUAL 0)
        string(JSON _status GET "${_stdout}" status)
        if(NOT _status STREQUAL "passed")
            message(FATAL_ERROR "${name}: invalid success receipt")
        endif()
        set(${name} "${_stdout}" PARENT_SCOPE)
    else()
        string(JSON _status GET "${_stderr}" status)
        string(JSON _error GET "${_stderr}" error)
        if(NOT _status STREQUAL "failed" OR _error STREQUAL "")
            message(FATAL_ERROR "${name}: missing explicit failure diagnostic")
        endif()
    endif()
endfunction()
invoke(old 0 validate "${LEVEL1}")
invoke(extended 0 inspect "${LEVEL2}")
invoke(progress 0 inspect "${LEVEL3}")
string(JSON _oldVersion GET "${old}" formatVersion)
string(JSON _newVersion GET "${extended}" formatVersion)
string(JSON _targets GET "${extended}" actionTargetCount)
string(JSON _rules GET "${extended}" ruleCount)
if(NOT _oldVersion EQUAL 1 OR NOT _newVersion EQUAL 2 OR NOT _targets EQUAL 3 OR NOT _rules EQUAL 5)
    message(FATAL_ERROR "Authoring tool did not inspect both actual format versions")
endif()
string(JSON _progressVersion GET "${progress}" formatVersion)
foreach(_field counterCount objectiveCount claimCount flowBindingCount objectiveActionCount)
    string(JSON _count GET "${progress}" "${_field}")
    set(_expected 2)
    if(_field STREQUAL "claimCount" OR _field STREQUAL "flowBindingCount")
        set(_expected 3)
    elseif(_field STREQUAL "objectiveActionCount")
        set(_expected 1)
    endif()
    if(NOT _progressVersion EQUAL 3 OR NOT _count EQUAL _expected)
        message(FATAL_ERROR "Actual authored progress inspection is incomplete")
    endif()
endforeach()
invoke(progressCanonical 0 canonicalize "${LEVEL3}" "${_run}/progress-canonical.dlt")
invoke(progressRoundtrip 0 inspect "${_run}/progress-canonical.dlt")
foreach(_field formatVersion applicationVersion inputVersion step contentHash actors rules counters objectives claims flowBindings objectiveActions)
    string(JSON _before GET "${progress}" "${_field}")
    string(JSON _after GET "${progressRoundtrip}" "${_field}")
    if(NOT _before STREQUAL _after)
        message(FATAL_ERROR "Progress canonicalization changed authoritative ${_field}")
    endif()
endforeach()
invoke(respawn 0 inspect "${LEVEL4}")
string(JSON _respawnVersion GET "${respawn}" formatVersion)
string(JSON _respawnFlag GET "${respawn}" characterRespawn)
foreach(_field spawnCount respawnBindingCount respawnRegionCount)
    string(JSON _count GET "${respawn}" "${_field}")
    set(_expected 2)
    if(_field STREQUAL "respawnBindingCount")
        set(_expected 1)
    endif()
    if(NOT _respawnVersion EQUAL 4 OR NOT _respawnFlag OR NOT _count EQUAL _expected)
        message(FATAL_ERROR "Actual authored respawn inspection is incomplete")
    endif()
endforeach()
invoke(respawnCanonical 0 canonicalize "${LEVEL4}" "${_run}/respawn-canonical.dlt")
invoke(respawnRoundtrip 0 inspect "${_run}/respawn-canonical.dlt")
foreach(_field formatVersion contentHash characterRespawn actors rules counters objectives claims flowBindings objectiveActions spawns respawnBindings respawnRegions)
    string(JSON _before GET "${respawn}" "${_field}")
    string(JSON _after GET "${respawnRoundtrip}" "${_field}")
    if(NOT _before STREQUAL _after)
        message(FATAL_ERROR "Respawn canonicalization changed authoritative ${_field}")
    endif()
endforeach()
invoke(decimal 0 float 0.1)
invoke(vitality 0 inspect "${LEVEL5}")
string(JSON _vitalityVersion GET "${vitality}" formatVersion)
string(JSON _vitalityRecovery GET "${vitality}" vitalityRespawnRecovery)
if(NOT _vitalityVersion EQUAL 5 OR NOT _vitalityRecovery)
    message(FATAL_ERROR "Actual vitality authoring did not select Level5 recovery")
endif()
foreach(_pair "vitalityActorCount;1" "vitalityPermissionCount;2" "vitalityRegionCount;4")
    list(GET _pair 0 _field)
    list(GET _pair 1 _expected)
    string(JSON _actual GET "${vitality}" "${_field}")
    if(NOT _actual EQUAL _expected)
        message(FATAL_ERROR "Actual authored vitality inspection ${_field} mismatch")
    endif()
endforeach()
string(JSON _maxHP GET "${vitality}" vitalityActors 0 maximumHP)
string(JSON _manualRecovery GET "${vitality}" vitalityActors 0 recoverManual)
string(JSON _lethalAmount GET "${vitality}" vitalityRegions 2 amount)
if(NOT _maxHP STREQUAL "5" OR NOT _manualRecovery OR NOT _lethalAmount STREQUAL "4")
    message(FATAL_ERROR "Vitality inspect omitted actual author permissions/amounts")
endif()
invoke(vitalityCanonical 0 canonicalize "${LEVEL5}" "${_run}/vitality-canonical.dlt")
invoke(vitalityRoundtrip 0 inspect "${_run}/vitality-canonical.dlt")
foreach(_field formatVersion contentHash characterRespawn actors rules counters objectives claims flowBindings objectiveActions spawns respawnBindings respawnRegions vitalityActors vitalityPermissions vitalityRegions maxVitalityOperationsPerTick vitalityRespawnRecovery)
    string(JSON _before GET "${vitality}" "${_field}")
    string(JSON _after GET "${vitalityRoundtrip}" "${_field}")
    if(NOT _before STREQUAL _after)
        message(FATAL_ERROR "Vitality canonicalization changed authoritative ${_field}")
    endif()
endforeach()
invoke(periodic 0 inspect "${LEVEL6}")
string(JSON _periodicVersion GET "${periodic}" formatVersion)
string(JSON _periodicEnabled GET "${periodic}" vitalityPeriodicRegions)
string(JSON _periodHurt GET "${periodic}" vitalityRegions 0 periodTicks)
string(JSON _periodHeal GET "${periodic}" vitalityRegions 1 periodTicks)
if(NOT _periodicVersion EQUAL 6 OR NOT _periodicEnabled OR NOT _periodHurt EQUAL 3 OR NOT _periodHeal EQUAL 2)
    message(FATAL_ERROR "Periodic inspect omitted actual authored intervals")
endif()
invoke(periodicCanonical 0 canonicalize "${LEVEL6}" "${_run}/periodic-canonical.dlt")
invoke(periodicRoundtrip 0 inspect "${_run}/periodic-canonical.dlt")
foreach(_field formatVersion contentHash characterRespawn actors spawns respawnBindings vitalityActors vitalityPermissions vitalityRegions maxVitalityOperationsPerTick vitalityRespawnRecovery vitalityPeriodicRegions)
    string(JSON _before GET "${periodic}" "${_field}")
    string(JSON _after GET "${periodicRoundtrip}" "${_field}")
    if(NOT _before STREQUAL _after)
        message(FATAL_ERROR "Periodic canonicalization changed authoritative ${_field}")
    endif()
endforeach()
invoke(moving 0 inspect "${LEVEL7}")
string(JSON _movingVersion GET "${moving}" formatVersion)
string(JSON _movingRole GET "${moving}" paths 0 movingTrigger)
string(JSON _movingTravel GET "${moving}" paths 0 waypoints 0 travelTicks)
if(NOT _movingVersion EQUAL 7 OR NOT _movingRole OR NOT _movingTravel EQUAL 8)
    message(FATAL_ERROR "Moving path inspection omitted actual role/duration")
endif()
invoke(movingCanonical 0 canonicalize "${LEVEL7}" "${_run}/moving-canonical.dlt")
invoke(movingRoundtrip 0 inspect "${_run}/moving-canonical.dlt")
foreach(_field formatVersion contentHash actors paths vitalityRegions vitalityPeriodicRegions)
    string(JSON _before GET "${moving}" "${_field}")
    string(JSON _after GET "${movingRoundtrip}" "${_field}")
    if(NOT _before STREQUAL _after)
        message(FATAL_ERROR "Moving region canonicalization changed ${_field}")
    endif()
endforeach()
string(JSON _bits GET "${decimal}" bits)
string(JSON _exact GET "${decimal}" exactDecimal)
if(NOT _bits STREQUAL "3dcccccd" OR NOT _exact STREQUAL "0.100000001490116119384765625")
    message(FATAL_ERROR "Decimal authoring did not preserve binary32 rounding/exact value")
endif()
invoke(negativeZero 0 float -0)
string(JSON _bits GET "${negativeZero}" bits)
string(JSON _exact GET "${negativeZero}" exactDecimal)
if(NOT _bits STREQUAL "80000000" OR NOT _exact STREQUAL "-0")
    message(FATAL_ERROR "Decimal authoring lost signed zero")
endif()
invoke(decimalOverflow 1 float 1e39)
invoke(decimalMalformed 1 float nan)
invoke(canonical 0 canonicalize "${LEVEL2}" "${_run}/canonical.dlt")
invoke(roundtrip 0 inspect "${_run}/canonical.dlt")
foreach(_field formatVersion applicationVersion inputVersion step contentHash actorCount pathCount actionTargetCount ruleCount actors rules)
    string(JSON _before GET "${extended}" "${_field}")
    string(JSON _after GET "${roundtrip}" "${_field}")
    if(NOT _before STREQUAL _after)
        message(FATAL_ERROR "Canonicalization changed authoritative ${_field}")
    endif()
endforeach()
invoke(canonicalAgain 0 canonicalize "${_run}/canonical.dlt" "${_run}/canonical-again.dlt")
file(SHA256 "${_run}/canonical.dlt" _first)
file(SHA256 "${_run}/canonical-again.dlt" _second)
if(NOT _first STREQUAL _second)
    message(FATAL_ERROR "Canonical writer was not stable")
endif()
file(WRITE "${_run}/protected.dlt" "KEEP EXISTING CONTENT\n")
file(SHA256 "${_run}/protected.dlt" _protected)
invoke(existing 1 canonicalize "${LEVEL2}" "${_run}/protected.dlt")
file(SHA256 "${_run}/protected.dlt" _after)
if(NOT _after STREQUAL _protected)
    message(FATAL_ERROR "Existing authoring resource was overwritten")
endif()
file(WRITE "${_run}/malformed.dlt" "AYDLEVEL 2\nsession broken\n")
invoke(malformed 1 canonicalize "${_run}/malformed.dlt" "${_run}/must-not-exist.dlt")
if(EXISTS "${_run}/must-not-exist.dlt")
    message(FATAL_ERROR "Invalid source created an output")
endif()
invoke(arguments 1 inspect "${LEVEL2}" unexpected)
message(STATUS "Level authoring: old/extended validate, inspect, canonicalize and protected/error flows passed; ${_run}")
