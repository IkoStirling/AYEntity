# Stage60 finite offline preview fragment. Invoke separately or include from the
# existing authoring gate with TOOL, LEVEL1, LEVEL10 and OUTPUT_DIR already bound.
# Never executes simulation ticks, a Host, a browser or a float corpus.
foreach(_preview_input TOOL LEVEL1 LEVEL10)
    if(NOT DEFINED ${_preview_input} OR NOT EXISTS "${${_preview_input}}" OR IS_DIRECTORY "${${_preview_input}}" OR IS_SYMLINK "${${_preview_input}}")
        message(FATAL_ERROR "${_preview_input} must name an ordinary existing file")
    endif()
endforeach()
if(NOT DEFINED OUTPUT_DIR OR OUTPUT_DIR STREQUAL "")
    message(FATAL_ERROR "OUTPUT_DIR must name the preview artifact parent")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
string(TIMESTAMP _preview_stamp "%Y%m%dT%H%M%S" UTC)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef _preview_nonce)
set(_preview_run "${OUTPUT_DIR}/preview-${_preview_stamp}-${_preview_nonce}")
if(EXISTS "${_preview_run}")
    message(FATAL_ERROR "Preview evidence directory must be fresh")
endif()
file(MAKE_DIRECTORY "${_preview_run}")
function(preview_invoke name expected)
    execute_process(COMMAND "${TOOL}" ${ARGN} RESULT_VARIABLE _exit OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr ENCODING UTF-8 TIMEOUT 15)
    file(WRITE "${_preview_run}/${name}.stdout.json" "${_stdout}")
    file(WRITE "${_preview_run}/${name}.stderr.json" "${_stderr}")
    if(NOT "${_exit}" STREQUAL "${expected}")
        message(FATAL_ERROR "${name}: unexpected exit ${_exit}; ${_stderr}; ${_preview_run}")
    endif()
    if(expected EQUAL 0)
        string(JSON _status GET "${_stdout}" status)
        string(JSON _command GET "${_stdout}" command)
        string(JSON _executed GET "${_stdout}" simulationExecuted)
        string(JSON _scope GET "${_stdout}" scope)
        if(NOT _status STREQUAL "passed" OR NOT _command STREQUAL "preview" OR _executed OR NOT _scope STREQUAL "authored-initial-content")
            message(FATAL_ERROR "${name}: missing bounded static-authoring receipt")
        endif()
        set(${name} "${_stdout}" PARENT_SCOPE)
    else()
        string(JSON _status GET "${_stderr}" status)
        string(JSON _error GET "${_stderr}" error)
        if(NOT _status STREQUAL "failed" OR _error STREQUAL "")
            message(FATAL_ERROR "${name}: missing explicit failure")
        endif()
    endif()
endfunction()
function(preview_contains data literal)
    string(FIND "${data}" "${literal}" _found)
    if(_found LESS 0)
        message(FATAL_ERROR "Missing independent preview literal: ${literal}")
    endif()
endfunction()
preview_invoke(terrain 0 preview "${LEVEL1}" "${_preview_run}/terrain.svg")
file(READ "${_preview_run}/terrain.svg" _svg)
file(SIZE "${_preview_run}/terrain.svg" _svgBytes)
if(_svgBytes GREATER 1048576)
    message(FATAL_ERROR "Preview output exceeded1MiB")
endif()
string(JSON _actors GET "${terrain}" actorCount)
string(JSON _paths GET "${terrain}" pathInstances)
string(JSON _points GET "${terrain}" waypointCount)
string(JSON _receiptBytes GET "${terrain}" svgBytes)
if(NOT _actors EQUAL 11 OR NOT _paths EQUAL 1 OR NOT _points EQUAL 2 OR NOT _receiptBytes EQUAL _svgBytes)
    message(FATAL_ERROR "Actual terrain source/preview counts differ")
endif()
# World bounds are(-2,-1)..(24,3); Y-flipped display origin is(-2,-3)
# with positive represented spans26x4. These are layout values, never a CP.
set(_world_expected c0000000 bf800000 41c00000 40400000)
set(_view_expected c0000000 c0400000 41d00000 40800000)
foreach(_lane RANGE 0 3)
    list(GET _world_expected ${_lane} _world)
    list(GET _view_expected ${_lane} _view)
    string(JSON _actualWorld GET "${terrain}" worldBoundsBits ${_lane})
    string(JSON _actualView GET "${terrain}" viewBoxBits ${_lane})
    if(NOT _actualWorld STREQUAL _world OR NOT _actualView STREQUAL _view)
        message(FATAL_ERROR "Independent terrain world/display bounds differ")
    endif()
endforeach()
# This shipped format1 fixture has a true right wedge0..2x0..1, true left
# wedge2..4x0..1 and MovingObstacle wedge20..24x0..2; expectations are dyadic.
preview_contains("${_svg}" "data-actor=\"100\" data-kind=\"aabb\"")
preview_contains("${_svg}" "points=\"-2,-1 0,-1 0,0 -2,0\"")
preview_contains("${_svg}" "data-actor=\"101\" data-kind=\"triangle\"")
preview_contains("${_svg}" "points=\"0,0 2,0 2,1\"")
preview_contains("${_svg}" "data-actor=\"102\" data-kind=\"triangle\"")
preview_contains("${_svg}" "points=\"2,0 4,0 2,1\"")
preview_contains("${_svg}" "data-actor=\"200\" data-kind=\"aabb\" data-role=\"trigger\"")
preview_contains("${_svg}" "data-actor=\"10\" data-kind=\"aabb\" data-role=\"character\"")
preview_contains("${_svg}" "data-path=\"1\" data-actor=\"130\" data-waypoint-count=\"2\" data-playback=\"2\" points=\"22,1 23,1\"")
preview_contains("${_svg}" "transform=\"scale(1,-1)\"")
preview_contains("${_svg}" "browser pixels are not authoritative")
string(FIND "${_svg}" "<script" _script)
string(FIND "${_svg}" "href=" _href)
if(NOT _script LESS 0 OR NOT _href LESS 0)
    message(FATAL_ERROR "Static preview contains executable or linked content")
endif()
preview_invoke(terrainAgain 0 preview "${LEVEL1}" "${_preview_run}/terrain-again.svg")
file(SHA256 "${_preview_run}/terrain.svg" _first)
file(SHA256 "${_preview_run}/terrain-again.svg" _second)
if(NOT _first STREQUAL _second)
    message(FATAL_ERROR "Identical source did not produce identical static SVG bytes")
endif()
preview_invoke(control 0 preview "${LEVEL10}" "${_preview_run}/control.svg")
string(JSON _format GET "${control}" formatVersion)
if(NOT _format EQUAL 10)
    message(FATAL_ERROR "Preview silently changed authored version10")
endif()
# One valid copied resource changes only a moving body's offset and a static
# body's mask. Body corners move by1/4, but path origins remain authored pose22,1.
file(READ "${LEVEL1}" _source)
set(_mover "actor 130 3 1 41b00000 3f800000 40000000 3f800000 00000000 00000000")
set(_offsetMover "actor 130 3 1 41b00000 3f800000 40000000 3f800000 3e800000 00000000")
set(_solid "actor 100 1 0 bf800000 bf000000 3f800000 3f000000 00000000 00000000 00000000 00000000 2 1")
set(_masked "actor 100 1 0 bf800000 bf000000 3f800000 3f000000 00000000 00000000 00000000 00000000 2 0")
preview_contains("${_source}" "${_mover}")
preview_contains("${_source}" "${_solid}")
string(REPLACE "${_mover}" "${_offsetMover}" _offsetSource "${_source}")
string(REPLACE "${_solid}" "${_masked}" _offsetSource "${_offsetSource}")
file(WRITE "${_preview_run}/offset-mask.dlt" "${_offsetSource}")
preview_invoke(offsetMask 0 preview "${_preview_run}/offset-mask.dlt" "${_preview_run}/offset-mask.svg")
file(READ "${_preview_run}/offset-mask.svg" _offsetSvg)
preview_contains("${_offsetSvg}" "points=\"20.25,0 24.25,0 24.25,2\"")
preview_contains("${_offsetSvg}" "data-path=\"1\" data-actor=\"130\" data-waypoint-count=\"2\" data-playback=\"2\" points=\"22,1 23,1\"")
preview_contains("${_offsetSvg}" "data-actor=\"100\" data-kind=\"aabb\" data-role=\"solid\" data-mode=\"1\" data-layer=\"2\" data-mask=\"0\"")
preview_contains("${_offsetSvg}" "opacity=\"0.35\"")
file(WRITE "${_preview_run}/protected.svg" "KEEP EXISTING SVG\n")
file(SHA256 "${_preview_run}/protected.svg" _protected)
preview_invoke(existing 1 preview "${LEVEL1}" "${_preview_run}/protected.svg")
file(SHA256 "${_preview_run}/protected.svg" _after)
if(NOT _protected STREQUAL _after)
    message(FATAL_ERROR "Preview replaced an existing output")
endif()
file(WRITE "${_preview_run}/malformed.dlt" "AYDLEVEL 1\nsession malformed\n")
preview_invoke(malformed 1 preview "${_preview_run}/malformed.dlt" "${_preview_run}/must-not-exist.svg")
if(EXISTS "${_preview_run}/must-not-exist.svg")
    message(FATAL_ERROR "Invalid source created a preview output")
endif()
# Reuse the shipped validated header with two active Static AABB triggers/mask0.
# Their poses are +/-2^127 and their half-widths2^123: each body's exact bounds
# and positive area are finite; the combined world X span overflows binary32.
# Disabled actors cannot be used here: the actual Level preflight rejects them.
string(FIND "${_source}" "paths 1" _headerEnd)
if(_headerEnd LESS 0)
    message(FATAL_ERROR "Expected shipped terrain header")
endif()
string(SUBSTRING "${_source}" 0 ${_headerEnd} _header)
file(WRITE "${_preview_run}/overflow.dlt" "${_header}paths 0\nactors 2\nactor 10 1 0 7f000000 00000000 7d000000 3f000000 00000000 00000000 00000000 00000000 1 0 1 0 0 0\nactor 20 1 0 ff000000 00000000 7d000000 3f000000 00000000 00000000 00000000 00000000 1 0 1 0 0 0\nend\n")
preview_invoke(overflow 1 preview "${_preview_run}/overflow.dlt" "${_preview_run}/overflow.svg")
file(READ "${_preview_run}/overflow.stderr.json" _overflowRecord)
string(JSON _overflowError GET "${_overflowRecord}" error)
preview_contains("${_overflowError}" "Nonfinite or overflowing preview geometry/span")
if(EXISTS "${_preview_run}/overflow.svg")
    message(FATAL_ERROR "Overflowing preview world span created an output")
endif()
message(STATUS "Finite offline preview hand points/roles/path-origin/identity/protected-output checks passed; ${_preview_run}")
