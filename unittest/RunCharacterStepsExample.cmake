# design reference: AYEntity/design.md Stage26; real standard Host, no fake Session adapter.
if(NOT DEFINED EXAMPLE OR NOT EXISTS "${EXAMPLE}" OR IS_DIRECTORY "${EXAMPLE}")
    message(FATAL_ERROR "EXAMPLE must name the built standard Host executable")
endif()
if(NOT DEFINED OUTPUT_DIR)
    message(FATAL_ERROR "OUTPUT_DIR must name the test artifact parent")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
string(TIMESTAMP _stamp "%Y%m%dT%H%M%S" UTC)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef _nonce)
set(_run "${OUTPUT_DIR}/run-${_stamp}-${_nonce}")
if(EXISTS "${_run}")
    message(FATAL_ERROR "Fresh artifact path already exists: ${_run}")
endif()
file(MAKE_DIRECTORY "${_run}")
set(_prefix "${_run}/steps")
execute_process(COMMAND "${EXAMPLE}" --scenario steps --ticks 128 --frame-divisor 128 --output "${_prefix}"
    RESULT_VARIABLE _exit OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr ENCODING UTF-8 TIMEOUT 100)
file(WRITE "${_run}/stdout.txt" "${_stdout}")
file(WRITE "${_run}/stderr.txt" "${_stderr}")
file(WRITE "${_run}/process-result.txt" "${_exit}\n")
if(NOT "${_exit}" STREQUAL "0")
    message(FATAL_ERROR "Step Host example failed (${_exit}); logs: ${_run}\n${_stderr}")
endif()
foreach(_suffix state trace summary.json)
    if(NOT EXISTS "${_prefix}.${_suffix}" OR IS_DIRECTORY "${_prefix}.${_suffix}" OR IS_SYMLINK "${_prefix}.${_suffix}")
        message(FATAL_ERROR "Host example did not create ordinary ${_suffix}: ${_run}")
    endif()
    file(SIZE "${_prefix}.${_suffix}" _size)
    if(_size LESS 1)
        message(FATAL_ERROR "Host example produced empty ${_suffix}: ${_run}")
    endif()
endforeach()
file(SIZE "${_prefix}.summary.json" _size)
if(_size GREATER 65536)
    message(FATAL_ERROR "Host summary is unexpectedly large: ${_run}")
endif()
file(READ "${_prefix}.summary.json" _summary)
foreach(_field status scenario controllerProfile collisionProfile nextTick builtInStepChecks steppedTicks)
    string(JSON _${_field} ERROR_VARIABLE _json_error GET "${_summary}" "${_field}")
    if(NOT _json_error STREQUAL "NOTFOUND")
        message(FATAL_ERROR "Invalid Host summary field ${_field}: ${_json_error}")
    endif()
endforeach()
if(NOT _status STREQUAL "passed" OR NOT _scenario STREQUAL "steps" OR NOT _controllerProfile STREQUAL "3"
    OR NOT _collisionProfile STREQUAL "4" OR NOT _nextTick STREQUAL "128" OR NOT _builtInStepChecks STREQUAL "ON")
    message(FATAL_ERROR "Host summary does not confirm the intended step scene/identity/final tick: ${_run}")
endif()
string(JSON _actor10 ERROR_VARIABLE _json_error GET "${_summary}" characterStepCounts "10")
if(NOT _json_error STREQUAL "NOTFOUND" OR NOT _actor10 MATCHES "^[0-9]+$" OR _actor10 LESS 3)
    message(FATAL_ERROR "Actor10 did not really complete the three Static steps: ${_run}")
endif()
if(NOT _steppedTicks MATCHES "^[0-9]+$" OR NOT _steppedTicks STREQUAL _actor10)
    message(FATAL_ERROR "Aggregate step count does not match the sole eligible scene actor: ${_run}")
endif()
foreach(_id 11 12 13 14)
    string(JSON _count ERROR_VARIABLE _json_error GET "${_summary}" characterStepCounts "${_id}")
    if(NOT _json_error STREQUAL "NOTFOUND" OR NOT _count STREQUAL "0")
        message(FATAL_ERROR "Blocked/flat reference actor${_id} unexpectedly stepped: ${_run}")
    endif()
endforeach()
# Built-in checks observe actual registered results and assert actor10's final
# foot=1 (centerY=3/2); this script does not decode an unknown checkpoint wire.
message(STATUS "Real standard Host step scene passed128 ticks; three actual steps; artifacts ${_run}")
