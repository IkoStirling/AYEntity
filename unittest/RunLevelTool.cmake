function(solid_contains data literal)
    string(FIND "${data}" "${literal}" _solidFound)
    if(_solidFound LESS 0)
        message(FATAL_ERROR "Missing independent solid-authoring literal: ${literal}")
    endif()
endfunction()
function(solid_nonactor_lines path output)
    file(STRINGS "${path}" _solidLines)
    set(_solidOther "")
    foreach(_solidLine IN LISTS _solidLines)
        if(NOT _solidLine MATCHES "^actors " AND NOT _solidLine MATCHES "^actor ")
            list(APPEND _solidOther "${_solidLine}")
        endif()
    endforeach()
    set(${output} "${_solidOther}" PARENT_SCOPE)
endfunction()
