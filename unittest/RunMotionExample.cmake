if(NOT DEFINED EXAMPLE OR NOT DEFINED OUTPUT_DIR)
    message(FATAL_ERROR "Expected real example path and artifact directory")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
string(TIMESTAMP _stamp "%Y%m%dT%H%M%S" UTC)
string(RANDOM LENGTH 8 ALPHABET 0123456789abcdef _nonce)
set(_prefix "${OUTPUT_DIR}/motion-${_stamp}-${_nonce}")
execute_process(COMMAND "${EXAMPLE}" --scenario motion --ticks 128 --output "${_prefix}"
    RESULT_VARIABLE _result OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 90)
file(WRITE "${_prefix}.stdout.txt" "${_stdout}")
file(WRITE "${_prefix}.stderr.txt" "${_stderr}")
if(NOT _result EQUAL 0)
    message(FATAL_ERROR "Motion Host example failed (${_result}): ${_stdout}\n${_stderr}")
endif()
if(NOT EXISTS "${_prefix}.summary.json")
    message(FATAL_ERROR "Actual Host did not write its summary")
endif()
file(READ "${_prefix}.summary.json" _summary)
string(JSON _scenario GET "${_summary}" scenario)
string(JSON _checked GET "${_summary}" builtInMotionChecks)
string(JSON _ticks GET "${_summary}" nextTick)
if(NOT _scenario STREQUAL "motion" OR NOT _checked OR NOT _ticks EQUAL 128)
    message(FATAL_ERROR "Actual motion summary did not satisfy the requested content check")
endif()
foreach(_feature slopeWalkTicks carryMoveTicks blockedPathTicks crushPreventedTicks)
    string(JSON _count GET "${_summary}" motionFeatures "${_feature}")
    if(NOT _count GREATER 0)
        message(FATAL_ERROR "Actual content result ${_feature} was not observed")
    endif()
endforeach()
message(STATUS "${_summary}")
