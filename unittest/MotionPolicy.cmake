# design reference: AYEntity/design.md Stage28; bounded prescribed-motion checks.
if(NOT DEFINED _det_motion_library)
    if(DEFINED _det_character_library)
        set(_det_motion_library ${_det_character_library})
    else()
        set(_det_motion_library AYEntityDeterminism)
    endif()
endif()
add_executable(AYEntity_MotionPolicyChecks "${AYENTITY_ROOT}/unittest/portable/motionpolicy.cpp")
target_link_libraries(AYEntity_MotionPolicyChecks PRIVATE ${_det_motion_library})
target_compile_features(AYEntity_MotionPolicyChecks PRIVATE cxx_std_23)
if(MSVC)
    target_compile_options(AYEntity_MotionPolicyChecks PRIVATE /utf-8)
endif()
set(_motion_policy_artifacts "${CMAKE_CURRENT_BINARY_DIR}/motion-policy-artifacts")
file(MAKE_DIRECTORY "${_motion_policy_artifacts}")
add_test(NAME AYEntity_MotionPolicyChecks COMMAND AYEntity_MotionPolicyChecks --output "${_motion_policy_artifacts}")
set_tests_properties(AYEntity_MotionPolicyChecks PROPERTIES TIMEOUT 120 LABELS "ayentity;determinism;motion;2d;rollback;replay")
