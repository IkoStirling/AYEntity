endif()
string(JSON _progressVersion GET "${progress}" formatVersion)
foreach(_field counterCount objectiveCount claimCount flowBindingCount objectiveActionCount)
    string(JSON _count GET "${progress}" "${_field}")
    set(_expected 2)
    if(_field STREQUAL "claimCount" OR _field STREQUAL "flowBindingCount")
        set(_expected 3)
    elseif(_field STREQUAL "objectiveActionCount")
        set(_expected 1)
    endif()
    if(NOT _progressVersion EQUAL 3 OR NOT _count EQUAL _expected)
        message(FATAL_ERROR "Actual authored progress inspection is incomplete")
    endif()
endforeach()
