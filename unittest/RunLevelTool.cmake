foreach(_input TOOL LEVEL1 LEVEL2)
    if(NOT DEFINED ${_input} OR NOT EXISTS "${${_input}}" OR IS_DIRECTORY "${${_input}}" OR IS_SYMLINK "${${_input}}")
        message(FATAL_ERROR "${_input} must be an ordinary existing file")
    endif()
endforeach()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
string(TIMESTAMP _stamp "%Y%m%dT%H%M%S" UTC)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef _nonce)
set(_run "${OUTPUT_DIR}/run-${_stamp}-${_nonce}")
if(EXISTS "${_run}")
    message(FATAL_ERROR "Artifact path must be fresh")
endif()
file(MAKE_DIRECTORY "${_run}")
function(invoke name expected)
    execute_process(COMMAND "${TOOL}" ${ARGN} RESULT_VARIABLE _exit
        OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr ENCODING UTF-8 TIMEOUT 15)
    file(WRITE "${_run}/${name}.stdout.json" "${_stdout}")
    file(WRITE "${_run}/${name}.stderr.json" "${_stderr}")
    if(NOT "${_exit}" STREQUAL "${expected}")
        message(FATAL_ERROR "${name}: unexpected exit ${_exit}; ${_stderr}; ${_run}")
    endif()
    if(expected EQUAL 0)
        string(JSON _status GET "${_stdout}" status)
        if(NOT _status STREQUAL "passed")
            message(FATAL_ERROR "${name}: invalid success receipt")
        endif()
        set(${name} "${_stdout}" PARENT_SCOPE)
    else()
        string(JSON _status GET "${_stderr}" status)
        string(JSON _error GET "${_stderr}" error)
        if(NOT _status STREQUAL "failed" OR _error STREQUAL "")
            message(FATAL_ERROR "${name}: missing explicit failure diagnostic")
        endif()
    endif()
endfunction()
invoke(old 0 validate "${LEVEL1}")
invoke(extended 0 inspect "${LEVEL2}")
string(JSON _oldVersion GET "${old}" formatVersion)
string(JSON _newVersion GET "${extended}" formatVersion)
string(JSON _targets GET "${extended}" actionTargetCount)
string(JSON _rules GET "${extended}" ruleCount)
if(NOT _oldVersion EQUAL 1 OR NOT _newVersion EQUAL 2 OR NOT _targets EQUAL 3 OR NOT _rules EQUAL 5)
    message(FATAL_ERROR "Authoring tool did not inspect both actual format versions")
endif()
invoke(canonical 0 canonicalize "${LEVEL2}" "${_run}/canonical.dlt")
invoke(roundtrip 0 inspect "${_run}/canonical.dlt")
foreach(_field formatVersion applicationVersion inputVersion step contentHash actorCount pathCount actionTargetCount ruleCount actors rules)
    string(JSON _before GET "${extended}" "${_field}")
    string(JSON _after GET "${roundtrip}" "${_field}")
    if(NOT _before STREQUAL _after)
        message(FATAL_ERROR "Canonicalization changed authoritative ${_field}")
    endif()
endforeach()
invoke(canonicalAgain 0 canonicalize "${_run}/canonical.dlt" "${_run}/canonical-again.dlt")
file(SHA256 "${_run}/canonical.dlt" _first)
file(SHA256 "${_run}/canonical-again.dlt" _second)
if(NOT _first STREQUAL _second)
    message(FATAL_ERROR "Canonical writer was not stable")
endif()
file(WRITE "${_run}/protected.dlt" "KEEP EXISTING CONTENT\n")
file(SHA256 "${_run}/protected.dlt" _protected)
invoke(existing 1 canonicalize "${LEVEL2}" "${_run}/protected.dlt")
file(SHA256 "${_run}/protected.dlt" _after)
if(NOT _after STREQUAL _protected)
    message(FATAL_ERROR "Existing authoring resource was overwritten")
endif()
file(WRITE "${_run}/malformed.dlt" "AYDLEVEL 2\nsession broken\n")
invoke(malformed 1 canonicalize "${_run}/malformed.dlt" "${_run}/must-not-exist.dlt")
if(EXISTS "${_run}/must-not-exist.dlt")
    message(FATAL_ERROR "Invalid source created an output")
endif()
invoke(arguments 1 inspect "${LEVEL2}" unexpected)
message(STATUS "Level authoring: old/extended validate, inspect, canonicalize and protected/error flows passed; ${_run}")
