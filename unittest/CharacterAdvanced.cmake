# design reference: AYEntity/design.md Stage22; opt-in registered practical movement.
if(NOT DEFINED _det_character_library)
    set(_det_character_library AYEntityDeterminism)
endif()
add_executable(AYEntity_CharacterAdvancedChecks "${AYENTITY_ROOT}/unittest/portable/characteradvanced.cpp")
target_link_libraries(AYEntity_CharacterAdvancedChecks PRIVATE ${_det_character_library})
target_compile_features(AYEntity_CharacterAdvancedChecks PRIVATE cxx_std_23)
if(MSVC)
    target_compile_options(AYEntity_CharacterAdvancedChecks PRIVATE /utf-8)
endif()
set(_advanced_character_artifacts "${CMAKE_CURRENT_BINARY_DIR}/character-advanced-artifacts")
file(MAKE_DIRECTORY "${_advanced_character_artifacts}")
add_test(NAME AYEntity_CharacterAdvancedChecks COMMAND AYEntity_CharacterAdvancedChecks --output "${_advanced_character_artifacts}")
set(_advanced_character_timeout "$<IF:$<CONFIG:Debug>,600,240>")
if(CMAKE_CXX_FLAGS MATCHES "[-/]fsanitize=address")
    set(_advanced_character_timeout 900)
endif()
set_tests_properties(AYEntity_CharacterAdvancedChecks PROPERTIES
    TIMEOUT "${_advanced_character_timeout}" LABELS "ayentity;determinism;character;advanced;2d;rollback;replay")
