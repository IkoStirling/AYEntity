# design reference: AYEntity/design.md Stage22; actual standard Host example processes.
if(NOT DEFINED EXAMPLE OR NOT DEFINED OUTPUT_DIR)
    message(FATAL_ERROR "EXAMPLE and OUTPUT_DIR required")
endif()
get_filename_component(_advanced_parent "${OUTPUT_DIR}" ABSOLUTE)
file(MAKE_DIRECTORY "${_advanced_parent}")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef _advanced_nonce)
set(_advanced_run "${_advanced_parent}/run-${_advanced_nonce}")
if(EXISTS "${_advanced_run}")
    message(FATAL_ERROR "Fresh example run directory already exists")
endif()
file(MAKE_DIRECTORY "${_advanced_run}")
function(run_example output)
    execute_process(COMMAND "${EXAMPLE}" ${ARGN} --ticks 512 --output "${_advanced_run}/${output}"
        RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE errors TIMEOUT 180)
    file(WRITE "${_advanced_run}/${output}.log" "${log}\n${errors}")
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Example ${output} failed: ${result}\n${log}\n${errors}")
    endif()
    file(READ "${_advanced_run}/${output}.summary.json" summary)
    string(JSON status GET "${summary}" status)
    string(JSON next_tick GET "${summary}" nextTick)
    if(NOT status STREQUAL "passed" OR NOT next_tick EQUAL 512)
        message(FATAL_ERROR "Example ${output} invalid completion summary")
    endif()
    foreach(feature coyoteJumps bufferedJumps drops crouchTicks blockedStandTicks carryTicks)
        string(JSON count GET "${summary}" features ${feature})
        if(NOT count GREATER 0)
            message(FATAL_ERROR "Example ${output} never exercised ${feature}")
        endif()
    endforeach()
endfunction()
run_example(baseline --record "${_advanced_run}/character.rpl" --frame-divisor 64)
run_example(live --frame-divisor 128)
run_example(playback --replay "${_advanced_run}/character_000.rpl" --frame-divisor 128)
run_example(seek --replay "${_advanced_run}/character_000.rpl" --seek 256 --frame-divisor 128)
function(compare_example left right)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${_advanced_run}/${left}" "${_advanced_run}/${right}"
        RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Standard Host advanced example witness differs: ${left} vs ${right}")
    endif()
endfunction()
compare_example(baseline.state live.state)
compare_example(baseline.state playback.state)
compare_example(baseline.state seek.state)
compare_example(baseline.trace live.trace)
compare_example(baseline.trace playback.trace)
file(READ "${_advanced_run}/baseline.trace" trace)
string(REPLACE "\n" ";" trace_lines "${trace}")
set(suffix "")
foreach(line IN LISTS trace_lines)
    if(line MATCHES "^([0-9]+) " AND CMAKE_MATCH_1 GREATER 256)
        string(APPEND suffix "${line}\n")
    endif()
endforeach()
file(WRITE "${_advanced_run}/baseline.suffix.trace" "${suffix}")
compare_example(baseline.suffix.trace seek.trace)
execute_process(COMMAND "${EXAMPLE}" --seek 1 RESULT_VARIABLE bad_cli OUTPUT_QUIET ERROR_QUIET TIMEOUT 10)
if(bad_cli EQUAL 0)
    message(FATAL_ERROR "Example accepted seek without replay")
endif()
message(STATUS "PASS: advanced real Host example512 ticks; features, canonical input, module startup, frame rates, live/record/replay/seek and exact checkpoint/trace equality; ${_advanced_run}")
