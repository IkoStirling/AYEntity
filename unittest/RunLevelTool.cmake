invoke(removeAuthority 1 remove-solid "${LEVEL11}" 101 "${_removeRejected}")
string(JSON _removeTriggerID GET "${progress}" claims 0 trigger)
invoke(removeTrigger 1 remove-solid "${LEVEL3}" "${_removeTriggerID}" "${_removeRejected}")
foreach(_removeBadID 0 999 18446744073709551616 -1 1x)
    string(MD5 _removeCaseID "${_removeBadID}")
    invoke("removeInvalid-${_removeCaseID}" 1 remove-solid "${_run}/solids.dlt" "${_removeBadID}" "${_removeRejected}")
endforeach()
invoke(removeArgc 1 remove-solid "${_run}/solids.dlt" "${_removeRejected}")
invoke(removeExistingOutput 1 remove-solid "${_run}/solids.dlt" 200 "${_run}/removed-200.dlt")
invoke(removeSourceOutput 1 remove-solid "${_run}/solids.dlt" 200 "${_run}/solids.dlt")
file(SHA256 "${_run}/solids.dlt" _removeSourceAfter)
file(SHA256 "${LEVEL11}" _removeAuthorityAfter)
file(SHA256 "${_run}/removed-200.dlt" _removeOutputAfter)
if(EXISTS "${_removeRejected}" OR NOT _removeSourceBefore STREQUAL _removeSourceAfter
    OR NOT _removeAuthorityBefore STREQUAL _removeAuthorityAfter OR NOT _removeOutputSHA STREQUAL _removeOutputAfter)
    message(FATAL_ERROR "Rejected deletion wrote output or replaced source/protected destination")
endif()
message(STATUS "Finite offline ordinary solid removal/full authority/namespace/canonical/fresh checks passed; ${_run}")

include("${CMAKE_CURRENT_LIST_DIR}/PreviewLevelTool.cmake")
message(STATUS "Level authoring: old/extended validate, inspect, canonicalize and protected/error flows passed; ${_run}")
