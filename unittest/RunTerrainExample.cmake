# Stage32 Live128 only. Full state/trace are saved; this helper does not decode
# checkpoint/replay wire or claim unexecuted Record/Replay/Seek acceptance.
foreach(_input EXAMPLE LEVEL)
    if(NOT DEFINED ${_input} OR NOT EXISTS "${${_input}}" OR IS_DIRECTORY "${${_input}}" OR IS_SYMLINK "${${_input}}")
        message(FATAL_ERROR "${_input} must name an ordinary existing file")
    endif()
endforeach()
if(NOT DEFINED OUTPUT_DIR)
    message(FATAL_ERROR "OUTPUT_DIR must name the artifact parent")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
string(TIMESTAMP _stamp "%Y%m%dT%H%M%S" UTC)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef _nonce)
set(_run "${OUTPUT_DIR}/run-${_stamp}-${_nonce}")
if(EXISTS "${_run}")
    message(FATAL_ERROR "Fresh artifact directory already exists: ${_run}")
endif()
file(MAKE_DIRECTORY "${_run}")
set(_prefix "${_run}/terrain")
execute_process(COMMAND "${EXAMPLE}" --level "${LEVEL}" --ticks 128 --frame-divisor 128 --require-features --output "${_prefix}"
    RESULT_VARIABLE _exit OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr ENCODING UTF-8 TIMEOUT 100)
file(WRITE "${_run}/stdout.txt" "${_stdout}")
file(WRITE "${_run}/stderr.txt" "${_stderr}")
file(WRITE "${_run}/process-result.txt" "${_exit}\n")
if(NOT "${_exit}" STREQUAL "0")
    message(FATAL_ERROR "Terrain Host example failed (${_exit}); logs: ${_run}\n${_stderr}")
endif()
foreach(_suffix state trace summary.json)
    if(NOT EXISTS "${_prefix}.${_suffix}" OR IS_DIRECTORY "${_prefix}.${_suffix}" OR IS_SYMLINK "${_prefix}.${_suffix}")
        message(FATAL_ERROR "Host did not create ordinary ${_suffix}: ${_run}")
    endif()
    file(SIZE "${_prefix}.${_suffix}" _size)
    if(_size LESS 1)
        message(FATAL_ERROR "Host produced empty ${_suffix}: ${_run}")
    endif()
endforeach()
file(SIZE "${_prefix}.summary.json" _size)
if(_size GREATER 65536)
    message(FATAL_ERROR "Terrain summary exceeds64KiB: ${_run}")
endif()
file(READ "${_prefix}.summary.json" _summary)
foreach(_field schema status scenario levelProfile controllerProfile collisionProfile mode initialTick nextTick traceRows inputCallbacks featureChecks finalHash contentHash)
    string(JSON _${_field} ERROR_VARIABLE _error GET "${_summary}" "${_field}")
    if(NOT _error STREQUAL "NOTFOUND")
        message(FATAL_ERROR "Invalid Terrain summary ${_field}: ${_error}")
    endif()
endforeach()
if(NOT _schema STREQUAL "1" OR NOT _status STREQUAL "passed" OR NOT _scenario STREQUAL "terrain" OR NOT _mode STREQUAL "live"
    OR NOT _levelProfile STREQUAL "1" OR NOT _controllerProfile STREQUAL "7" OR NOT _collisionProfile STREQUAL "8"
    OR NOT _initialTick STREQUAL "0" OR NOT _nextTick STREQUAL "128" OR NOT _traceRows STREQUAL "128"
    OR NOT _inputCallbacks STREQUAL "128" OR NOT _featureChecks STREQUAL "ON")
    message(FATAL_ERROR "Terrain summary does not match the actual intended Live128 recipe: ${_run}")
endif()
foreach(_hash finalHash contentHash)
    string(JSON _type TYPE "${_summary}" "${_hash}")
    if(NOT _type STREQUAL "STRING" OR NOT _${_hash} MATCHES "^[0-9]+$")
        message(FATAL_ERROR "${_hash} must be a decimal string, preserving64-bit identity")
    endif()
endforeach()
foreach(_feature staticSlopeWalkTicks movingSlopeCarryTicks)
    string(JSON _count ERROR_VARIABLE _error GET "${_summary}" features "${_feature}")
    string(JSON _type ERROR_VARIABLE _type_error TYPE "${_summary}" features "${_feature}")
    if(NOT _error STREQUAL "NOTFOUND" OR NOT _type_error STREQUAL "NOTFOUND" OR NOT _type STREQUAL "NUMBER"
        OR NOT _count MATCHES "^[0-9]+$" OR _count LESS 1)
        message(FATAL_ERROR "Actual committed ${_feature} was not observed: ${_run}")
    endif()
endforeach()
message(STATUS "Standard Host loaded the public level resource and observed static walking/moving carry over128 ticks; artifacts ${_run}")
