# Fresh six-process standard Host closure, not a long campaign or native VM claim.
foreach(_input EXAMPLE LEVEL)
    if(NOT DEFINED ${_input} OR NOT EXISTS "${${_input}}" OR IS_DIRECTORY "${${_input}}" OR IS_SYMLINK "${${_input}}")
        message(FATAL_ERROR "${_input} must name an ordinary existing file")
    endif()
endforeach()
if(NOT DEFINED OUTPUT_DIR)
    message(FATAL_ERROR "OUTPUT_DIR required")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
string(TIMESTAMP _stamp "%Y%m%dT%H%M%S" UTC)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef _nonce)
set(_run "${OUTPUT_DIR}/run-${_stamp}-${_nonce}")
if(EXISTS "${_run}")
    message(FATAL_ERROR "Fresh sight artifact directory exists")
endif()
file(MAKE_DIRECTORY "${_run}")
function(run_example name)
    execute_process(COMMAND "${EXAMPLE}" --level "${LEVEL}" --ticks 64 --require-features
        --output "${_run}/${name}" ${ARGN}
        RESULT_VARIABLE _exit OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr ENCODING UTF-8 TIMEOUT 20)
    file(WRITE "${_run}/${name}.stdout.txt" "${_stdout}")
    file(WRITE "${_run}/${name}.stderr.txt" "${_stderr}")
    file(WRITE "${_run}/${name}.exit.txt" "${_exit}\n")
    if(NOT "${_exit}" STREQUAL "0")
        message(FATAL_ERROR "Sight ${name} failed (${_exit}); ${_run}\n${_stderr}")
    endif()
endfunction()
run_example(live --save-at 9 --save "${_run}/boundary9.dsv")
run_example(load --load "${_run}/boundary9.dsv")
run_example(record --record "${_run}/sight.rpl")
file(READ "${_run}/record.summary.json" _record)
string(JSON _recording GET "${_record}" recordingPath)
if(NOT EXISTS "${_recording}" OR IS_DIRECTORY "${_recording}" OR IS_SYMLINK "${_recording}")
    message(FATAL_ERROR "Recorder did not seal an ordinary file")
endif()
run_example(replay --replay "${_recording}")
run_example(seek --replay "${_recording}" --seek 9)
# 9rows to CP9/save, 4extra rows to CP13, real load9, then55rows to CP64.
# The restored registered door is open while the old Brain observation is blocked.
file(WRITE "${_run}/commands.txt" "closed 8\nopen\nsave ${_run}/interactive9.dsv\nidle 4\nload ${_run}/interactive9.dsv\nidle 55\nstatus\nquit\n")
execute_process(COMMAND "${EXAMPLE}" --level "${LEVEL}" --ticks 64 --interactive --require-features
    --output "${_run}/interactive" INPUT_FILE "${_run}/commands.txt"
    RESULT_VARIABLE _exit OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr ENCODING UTF-8 TIMEOUT 20)
file(WRITE "${_run}/interactive.stdout.txt" "${_stdout}")
file(WRITE "${_run}/interactive.stderr.txt" "${_stderr}")
file(WRITE "${_run}/interactive.exit.txt" "${_exit}\n")
if(NOT "${_exit}" STREQUAL "0")
    message(FATAL_ERROR "Actual sight stdin/save/load failed (${_exit}); ${_run}\n${_stderr}")
endif()
foreach(_name live load record replay seek interactive)
    foreach(_suffix state trace summary.json)
        if(NOT EXISTS "${_run}/${_name}.${_suffix}" OR IS_DIRECTORY "${_run}/${_name}.${_suffix}" OR IS_SYMLINK "${_run}/${_name}.${_suffix}")
            message(FATAL_ERROR "Missing ${_name} ${_suffix}")
        endif()
        file(SIZE "${_run}/${_name}.${_suffix}" _size)
        if(_size LESS 1)
            message(FATAL_ERROR "Empty ${_name} ${_suffix}")
        endif()
    endforeach()
    file(READ "${_run}/${_name}.summary.json" _summary)
    foreach(_field schema status scenario nextTick traceRows inputCallbacks featureChecks historicalBlockedMaskOpenSeen levelProfile brainProfile inputPayloadBytes)
        string(JSON _${_field} GET "${_summary}" "${_field}")
    endforeach()
    set(_rows 64)
    set(_calls 0)
    if(_name STREQUAL "live" OR _name STREQUAL "record")
        set(_calls 64)
    elseif(_name STREQUAL "load" OR _name STREQUAL "seek")
        set(_rows 55)
        if(_name STREQUAL "load")
            set(_calls 55)
        endif()
    elseif(_name STREQUAL "interactive")
        set(_rows 68)
        set(_calls 68)
    endif()
    if(NOT _schema STREQUAL "1" OR NOT _status STREQUAL "passed" OR NOT _scenario STREQUAL "sight"
        OR NOT _nextTick STREQUAL "64" OR NOT _traceRows STREQUAL "${_rows}" OR NOT _inputCallbacks STREQUAL "${_calls}"
        OR NOT _featureChecks STREQUAL "ON" OR NOT _historicalBlockedMaskOpenSeen STREQUAL "ON"
        OR NOT _levelProfile STREQUAL "11" OR NOT _brainProfile STREQUAL "2" OR NOT _inputPayloadBytes STREQUAL "1")
        message(FATAL_ERROR "${_name} summary differs from actual sight lifecycle; ${_run}")
    endif()
    string(JSON _hp GET "${_summary}" hero hp)
    string(JSON _hurts GET "${_summary}" hero hurts)
    string(JSON _attacks GET "${_summary}" enemy attacks)
    string(JSON _attempts GET "${_summary}" enemy attempts)
    string(JSON _pulses GET "${_summary}" enemy pulses)
    string(JSON _mask GET "${_summary}" doorMask)
    if(NOT _hp EQUAL 88 OR NOT _hurts EQUAL 6 OR NOT _attacks EQUAL 7 OR NOT _attempts EQUAL 6 OR NOT _pulses EQUAL 7 OR NOT _mask EQUAL 0)
        message(FATAL_ERROR "${_name} finite authored door/Hurt hand values differ")
    endif()
    file(STRINGS "${_run}/${_name}.trace" _trace)
    list(LENGTH _trace _traceCount)
    if(NOT _traceCount EQUAL _rows)
        message(FATAL_ERROR "${_name} trace-row mismatch")
    endif()
    file(SHA256 "${_run}/${_name}.state" _stateHash)
    if(_name STREQUAL "live")
        set(_expectedState "${_stateHash}")
    elseif(NOT _stateHash STREQUAL "${_expectedState}")
        message(FATAL_ERROR "Complete registered sight state differs for ${_name}")
    endif()
endforeach()
file(READ "${_run}/live.trace" _liveTrace)
foreach(_name record replay)
    file(READ "${_run}/${_name}.trace" _trace)
    if(NOT _liveTrace STREQUAL _trace)
        message(FATAL_ERROR "Live/${_name} complete per-tick hashes differ")
    endif()
endforeach()
file(STRINGS "${_run}/live.trace" _rows)
list(SUBLIST _rows 9 55 _suffixRows)
foreach(_name load seek)
    file(STRINGS "${_run}/${_name}.trace" _trace)
    if(NOT _suffixRows STREQUAL _trace)
        message(FATAL_ERROR "${_name} continuation differs from historical blocked/open CP9 suffix")
    endif()
endforeach()
file(STRINGS "${_run}/interactive.trace" _interactiveTrace)
list(SUBLIST _interactiveTrace 13 55 _interactiveSuffix)
if(NOT _suffixRows STREQUAL _interactiveSuffix)
    message(FATAL_ERROR "Actual stdin persisted load differs from complete suffix")
endif()
foreach(_file boundary9.dsv interactive9.dsv)
    if(NOT EXISTS "${_run}/${_file}" OR IS_DIRECTORY "${_run}/${_file}" OR IS_SYMLINK "${_run}/${_file}")
        message(FATAL_ERROR "Missing actual persistent save")
    endif()
endforeach()
file(SHA256 "${_run}/boundary9.dsv" _scriptSave)
file(SHA256 "${_run}/interactive9.dsv" _stdinSave)
if(NOT _scriptSave STREQUAL _stdinSave)
    message(FATAL_ERROR "Scripted/stdin historical observation full save bytes differ")
endif()
message(STATUS "Sight Host: real registered door actions; blocked0..8/capture-before-input; CP9 mask0 with oldBlocked; pulse9/Hurt12+9k; six complete state/trace/suffix paths agree; artifacts ${_run}")
