# Stage35 five short real Host processes, including actual stdin commands.
foreach(_input EXAMPLE LEVEL)
    if(NOT DEFINED ${_input} OR NOT EXISTS "${${_input}}" OR IS_DIRECTORY "${${_input}}" OR IS_SYMLINK "${${_input}}")
        message(FATAL_ERROR "${_input} must be an ordinary existing file")
    endif()
endforeach()
if(NOT DEFINED OUTPUT_DIR)
    message(FATAL_ERROR "OUTPUT_DIR required")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
string(TIMESTAMP _stamp "%Y%m%dT%H%M%S" UTC)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef _nonce)
set(_run "${OUTPUT_DIR}/run-${_stamp}-${_nonce}")
if(EXISTS "${_run}")
    message(FATAL_ERROR "Fresh artifact directory exists")
endif()
file(MAKE_DIRECTORY "${_run}")
function(run_example name)
    execute_process(COMMAND "${EXAMPLE}" --level "${LEVEL}" --ticks 160 --require-features
        --output "${_run}/${name}" ${ARGN}
        RESULT_VARIABLE _exit OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr ENCODING UTF-8 TIMEOUT 20)
    file(WRITE "${_run}/${name}.stdout.txt" "${_stdout}")
    file(WRITE "${_run}/${name}.stderr.txt" "${_stderr}")
    file(WRITE "${_run}/${name}.exit.txt" "${_exit}\n")
    if(NOT "${_exit}" STREQUAL "0")
        message(FATAL_ERROR "Interaction ${name} failed (${_exit}); ${_run}\n${_stderr}")
    endif()
endfunction()
run_example(live --check-restore)
run_example(record --record "${_run}/interaction.rpl")
file(READ "${_run}/record.summary.json" _record)
string(JSON _recording GET "${_record}" recordingPath)
if(NOT EXISTS "${_recording}" OR IS_DIRECTORY "${_recording}" OR IS_SYMLINK "${_recording}")
    message(FATAL_ERROR "Recorder did not seal an ordinary file")
endif()
run_example(replay --replay "${_recording}")
run_example(seek --replay "${_recording}" --seek 64)
file(WRITE "${_run}/commands.txt" "right 44\nrestart\nright 43\nclose\nsave\nright 16\nload\nright 71\nstatus\nquit\n")
execute_process(COMMAND "${EXAMPLE}" --level "${LEVEL}" --ticks 160 --interactive --require-features
    --output "${_run}/interactive" INPUT_FILE "${_run}/commands.txt"
    RESULT_VARIABLE _exit OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr ENCODING UTF-8 TIMEOUT 20)
file(WRITE "${_run}/interactive.stdout.txt" "${_stdout}")
file(WRITE "${_run}/interactive.stderr.txt" "${_stderr}")
file(WRITE "${_run}/interactive.exit.txt" "${_exit}\n")
if(NOT "${_exit}" STREQUAL "0")
    message(FATAL_ERROR "Actual console-input Host failed (${_exit}); ${_run}\n${_stderr}")
endif()
foreach(_name live record replay seek interactive)
    foreach(_suffix state trace summary.json)
        if(NOT EXISTS "${_run}/${_name}.${_suffix}" OR IS_DIRECTORY "${_run}/${_name}.${_suffix}" OR IS_SYMLINK "${_run}/${_name}.${_suffix}")
            message(FATAL_ERROR "Missing ${_name} ${_suffix}")
        endif()
        file(SIZE "${_run}/${_name}.${_suffix}" _size)
        if(_size LESS 1)
            message(FATAL_ERROR "Empty ${_name} ${_suffix}")
        endif()
    endforeach()
    file(READ "${_run}/${_name}.summary.json" _summary)
    foreach(_field schema status scenario mode interactive initialTick nextTick traceRows inputCallbacks restores featureChecks finalHash)
        string(JSON _${_field} ERROR_VARIABLE _error GET "${_summary}" "${_field}")
        if(NOT _error STREQUAL "NOTFOUND")
            message(FATAL_ERROR "Invalid ${_name} ${_field}")
        endif()
    endforeach()
    set(_initial 0)
    set(_rows 160)
    set(_calls 0)
    set(_restores 0)
    set(_expectedMode replay)
    set(_expectedInteractive OFF)
    if(_name STREQUAL "live")
        set(_rows 192)
        set(_calls 192)
        set(_restores 1)
        set(_expectedMode live)
    elseif(_name STREQUAL "record")
        set(_calls 160)
        set(_expectedMode record)
    elseif(_name STREQUAL "seek")
        set(_initial 64)
        set(_rows 96)
    elseif(_name STREQUAL "interactive")
        set(_rows 176)
        set(_calls 176)
        set(_restores 1)
        set(_expectedMode live)
        set(_expectedInteractive ON)
    endif()
    if(NOT _schema STREQUAL "1" OR NOT _status STREQUAL "passed" OR NOT _scenario STREQUAL "interaction"
        OR NOT _mode STREQUAL "${_expectedMode}" OR NOT _initialTick STREQUAL "${_initial}"
        OR NOT _nextTick STREQUAL "160" OR NOT _traceRows STREQUAL "${_rows}"
        OR NOT _inputCallbacks STREQUAL "${_calls}" OR NOT _restores STREQUAL "${_restores}"
        OR NOT _interactive STREQUAL "${_expectedInteractive}" OR NOT _featureChecks STREQUAL "ON")
        message(FATAL_ERROR "${_name} summary does not match real execution; ${_run}")
    endif()
    foreach(_feature opened closed paused resumed collected occupiedDenied restartDenied)
        string(JSON _count GET "${_summary}" features "${_feature}")
        if(NOT _count MATCHES "^[0-9]+$" OR _count LESS 1)
            message(FATAL_ERROR "${_name} has no actual ${_feature}")
        endif()
    endforeach()
    file(STRINGS "${_run}/${_name}.trace" _trace)
    list(LENGTH _trace _traceCount)
    if(NOT _traceCount EQUAL _rows)
        message(FATAL_ERROR "${_name} trace-row mismatch")
    endif()
    file(SHA256 "${_run}/${_name}.state" _stateHash)
    if(_name STREQUAL "live")
        set(_expectedState "${_stateHash}")
    elseif(NOT _stateHash STREQUAL "${_expectedState}")
        message(FATAL_ERROR "Complete state differs for ${_name}; ${_run}")
    endif()
endforeach()
file(READ "${_run}/record.trace" _recordTrace)
file(READ "${_run}/replay.trace" _replayTrace)
if(NOT _recordTrace STREQUAL _replayTrace)
    message(FATAL_ERROR "Record/replay complete per-tick hashes differ")
endif()
file(STRINGS "${_run}/record.trace" _rows)
list(SUBLIST _rows 64 96 _suffixRows)
file(STRINGS "${_run}/seek.trace" _seekRows)
if(NOT _suffixRows STREQUAL _seekRows)
    message(FATAL_ERROR "Seek trace does not match recorded suffix")
endif()
message(STATUS "Interaction Host: actual console input, Live restore, Record/Replay/Seek agree; artifacts ${_run}")
