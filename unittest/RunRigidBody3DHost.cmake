if(NOT DEFINED EXAMPLE OR NOT DEFINED ROOT OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "Required EXAMPLE ROOT OUTPUT")
endif()
string(TIMESTAMP _stamp "%Y%m%dT%H%M%S" UTC)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef _nonce)
set(_run "${OUTPUT}/run-${_stamp}-${_nonce}")
if(EXISTS "${_run}")
    message(FATAL_ERROR "Fresh gate directory required")
endif()
file(MAKE_DIRECTORY "${_run}")
function(_run_case name)
    execute_process(COMMAND "${EXAMPLE}" --ticks 64 --output "${_run}/${name}" ${ARGN}
        WORKING_DIRECTORY "${ROOT}" RESULT_VARIABLE _exit TIMEOUT 120
        OUTPUT_FILE "${_run}/${name}.stdout.txt" ERROR_FILE "${_run}/${name}.stderr.txt")
    if(NOT _exit EQUAL 0)
        file(READ "${_run}/${name}.stderr.txt" _error)
        message(FATAL_ERROR "Actual ${name} exit ${_exit}: ${_error}")
    endif()
    file(READ "${_run}/${name}.summary.json" _summary)
    string(JSON _status GET "${_summary}" status)
    string(JSON _ticks GET "${_summary}" ticks)
    string(JSON _version GET "${_summary}" manifestVersion)
    if(NOT _status STREQUAL "passed" OR NOT _ticks EQUAL 64 OR NOT _version EQUAL 5)
        message(FATAL_ERROR "Actual ${name} scope invalid")
    endif()
    set(${name}_summary "${_summary}" PARENT_SCOPE)
endfunction()
_run_case(live --verify-restore)
_run_case(record --record "${_run}/recording")
string(JSON _recording GET "${record_summary}" recordingPath)
if(_recording STREQUAL "" OR NOT EXISTS "${_recording}")
    message(FATAL_ERROR "Missing real closed recording")
endif()
_run_case(replay --replay "${_recording}")
foreach(_name record replay)
    foreach(_suffix state trace)
        execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${_run}/live.${_suffix}" "${_run}/${_name}.${_suffix}" RESULT_VARIABLE _same)
        if(NOT _same EQUAL 0)
            message(FATAL_ERROR "Actual ${_name} full ${_suffix} differs")
        endif()
    endforeach()
endforeach()
string(JSON _live_adv GET "${live_summary}" advances)
string(JSON _restore GET "${live_summary}" restoreVerified)
string(JSON _record_adv GET "${record_summary}" advances)
string(JSON _replay_adv GET "${replay_summary}" advances)
if(NOT _live_adv EQUAL 96 OR NOT _record_adv EQUAL 64 OR NOT _replay_adv EQUAL 64 OR NOT _restore)
    message(FATAL_ERROR "Actual advance/restore counts invalid")
endif()
file(SHA256 "${_run}/live.state" _state_sha)
file(SHA256 "${_run}/live.trace" _trace_sha)
file(WRITE "${_run}/result.json" "{\"status\":\"passed\",\"liveAdvances\":96,\"recordAdvances\":64,\"replayAdvances\":64,\"fullStateAndTraceEqual\":true,\"manifestVersion\":5,\"stateSHA256\":\"${_state_sha}\",\"traceSHA256\":\"${_trace_sha}\"}\n")
message(STATUS "PASS actual rigid3D Host Live96/Record64/Replay64, full CP/trace equality, restore suffix and final seek: ${_run}")
