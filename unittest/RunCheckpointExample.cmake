# Stage46 six short actual standard Host processes, including persistent save/load.
foreach(_input EXAMPLE LEVEL)
    if(NOT DEFINED ${_input} OR NOT EXISTS "${${_input}}" OR IS_DIRECTORY "${${_input}}" OR IS_SYMLINK "${${_input}}")
        message(FATAL_ERROR "${_input} must be an ordinary existing file")
    endif()
endforeach()
if(NOT DEFINED OUTPUT_DIR)
    message(FATAL_ERROR "OUTPUT_DIR required")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
string(TIMESTAMP _stamp "%Y%m%dT%H%M%S" UTC)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef _nonce)
set(_run "${OUTPUT_DIR}/run-${_stamp}-${_nonce}")
if(EXISTS "${_run}")
    message(FATAL_ERROR "Fresh checkpoint artifact directory exists")
endif()
file(MAKE_DIRECTORY "${_run}")
function(run_example name)
    execute_process(COMMAND "${EXAMPLE}" --level "${LEVEL}" --ticks 128 --require-features
        --output "${_run}/${name}" ${ARGN}
        RESULT_VARIABLE _exit OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr ENCODING UTF-8 TIMEOUT 20)
    file(WRITE "${_run}/${name}.stdout.txt" "${_stdout}")
    file(WRITE "${_run}/${name}.stderr.txt" "${_stderr}")
    file(WRITE "${_run}/${name}.exit.txt" "${_exit}\n")
    if(NOT "${_exit}" STREQUAL "0")
        message(FATAL_ERROR "Checkpoint ${name} failed (${_exit}); ${_run}\n${_stderr}")
    endif()
endfunction()
run_example(live --verify-boundaries --save-at 64 --save "${_run}/boundary64.dsv")
run_example(load --load "${_run}/boundary64.dsv")
run_example(record --record "${_run}/checkpoint.rpl")
file(READ "${_run}/record.summary.json" _record)
string(JSON _recording GET "${_record}" recordingPath)
if(NOT EXISTS "${_recording}" OR IS_DIRECTORY "${_recording}" OR IS_SYMLINK "${_recording}")
    message(FATAL_ERROR "Recorder did not seal an ordinary file")
endif()
run_example(replay --replay "${_recording}")
run_example(seek --replay "${_recording}" --seek 64)
file(WRITE "${_run}/commands.txt" "right 42\njump\nright 21\nsave ${_run}/interactive64.dsv\nright 16\nload ${_run}/interactive64.dsv\nright 40\nrespawn\nidle 23\nstatus\nquit\n")
execute_process(COMMAND "${EXAMPLE}" --level "${LEVEL}" --ticks 128 --interactive --require-features
    --output "${_run}/interactive" INPUT_FILE "${_run}/commands.txt"
    RESULT_VARIABLE _exit OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr ENCODING UTF-8 TIMEOUT 20)
file(WRITE "${_run}/interactive.stdout.txt" "${_stdout}")
file(WRITE "${_run}/interactive.stderr.txt" "${_stderr}")
file(WRITE "${_run}/interactive.exit.txt" "${_exit}\n")
if(NOT "${_exit}" STREQUAL "0")
    message(FATAL_ERROR "Actual checkpoint stdin/save/load failed (${_exit}); ${_run}\n${_stderr}")
endif()
foreach(_name live load record replay seek interactive)
    foreach(_suffix state trace summary.json)
        if(NOT EXISTS "${_run}/${_name}.${_suffix}" OR IS_DIRECTORY "${_run}/${_name}.${_suffix}" OR IS_SYMLINK "${_run}/${_name}.${_suffix}")
            message(FATAL_ERROR "Missing ${_name} ${_suffix}")
        endif()
        file(SIZE "${_run}/${_name}.${_suffix}" _size)
        if(_size LESS 1)
            message(FATAL_ERROR "Empty ${_name} ${_suffix}")
        endif()
    endforeach()
    file(READ "${_run}/${_name}.summary.json" _summary)
    string(JSON _observationRejects GET "${_summary}" observationRejects)
    if((_name STREQUAL "live" AND NOT _observationRejects STREQUAL "2") OR
        (NOT _name STREQUAL "live" AND NOT _observationRejects STREQUAL "0"))
        message(FATAL_ERROR "${_name} observation authority checks mismatch")
    endif()
    foreach(_field schema status scenario mode interactive initialTick nextTick traceRows inputCallbacks saves loads featureChecks finalHash keys finish exitUnlocked complete)
        string(JSON _${_field} ERROR_VARIABLE _error GET "${_summary}" "${_field}")
        if(NOT _error STREQUAL "NOTFOUND")
            message(FATAL_ERROR "Invalid ${_name} ${_field}")
        endif()
    endforeach()
    set(_initial 0)
    set(_rows 128)
    set(_calls 0)
    set(_expectedLoads 0)
    set(_expectedSaves 0)
    set(_expectedMode replay)
    set(_expectedInteractive OFF)
    if(_name STREQUAL "live")
        set(_expectedMode live)
        set(_calls 128)
        set(_expectedSaves 1)
    elseif(_name STREQUAL "load")
        set(_expectedMode live)
        set(_initial 64)
        set(_rows 64)
        set(_calls 64)
        set(_expectedLoads 1)
    elseif(_name STREQUAL "record")
        set(_expectedMode record)
        set(_calls 128)
    elseif(_name STREQUAL "seek")
        set(_initial 64)
        set(_rows 64)
    elseif(_name STREQUAL "interactive")
        set(_expectedMode live)
        set(_rows 144)
        set(_calls 144)
        set(_expectedLoads 1)
        set(_expectedSaves 1)
        set(_expectedInteractive ON)
    endif()
    if(NOT _schema STREQUAL "1" OR NOT _status STREQUAL "passed" OR NOT _scenario STREQUAL "checkpoint"
        OR NOT _mode STREQUAL "${_expectedMode}" OR NOT _initialTick STREQUAL "${_initial}" OR NOT _nextTick STREQUAL "128"
        OR NOT _traceRows STREQUAL "${_rows}" OR NOT _inputCallbacks STREQUAL "${_calls}"
        OR NOT _loads STREQUAL "${_expectedLoads}" OR NOT _saves STREQUAL "${_expectedSaves}"
        OR NOT _interactive STREQUAL "${_expectedInteractive}" OR NOT _featureChecks STREQUAL "ON"
        OR NOT _keys STREQUAL "2" OR NOT _finish STREQUAL "1" OR NOT _exitUnlocked STREQUAL "ON" OR NOT _complete STREQUAL "ON")
        message(FATAL_ERROR "${_name} summary does not match actual checkpoint lifecycle; ${_run}")
    endif()
    foreach(_feature opened paused resumed carriedTicks)
        string(JSON _count GET "${_summary}" features "${_feature}")
        if(NOT _count MATCHES "^[0-9]+$" OR _count LESS 1)
            message(FATAL_ERROR "${_name} missing actual ${_feature}")
        endif()
    endforeach()
    string(JSON _claims GET "${_summary}" features claims)
    string(JSON _finishes GET "${_summary}" features finishes)
    string(JSON _denied GET "${_summary}" features denied)
    if(NOT _claims STREQUAL "3" OR NOT _finishes STREQUAL "1" OR NOT _denied STREQUAL "0")
        message(FATAL_ERROR "${_name} unexpected progress attempts")
    endif()
    foreach(_feature respawnAccepted respawnDenied)
        string(JSON _count GET "${_summary}" features "${_feature}")
        if((_feature STREQUAL "respawnAccepted" AND NOT _count STREQUAL "2") OR
            (_feature STREQUAL "respawnDenied" AND NOT _count STREQUAL "0"))
            message(FATAL_ERROR "${_name} actual ${_feature} mismatch")
        endif()
    endforeach()
    foreach(_feature activeSpawn checkpointCount deathCount manualCount requestCount)
        string(JSON _count GET "${_summary}" respawn "${_feature}")
        if((_feature STREQUAL "checkpointCount" AND _count LESS 2) OR
            ((_feature STREQUAL "activeSpawn" OR _feature STREQUAL "requestCount") AND NOT _count STREQUAL "2") OR
            ((_feature STREQUAL "deathCount" OR _feature STREQUAL "manualCount") AND NOT _count STREQUAL "1"))
            message(FATAL_ERROR "${_name} actual ${_feature} mismatch")
        endif()
    endforeach()
    file(STRINGS "${_run}/${_name}.trace" _trace)
    list(LENGTH _trace _traceCount)
    if(NOT _traceCount EQUAL _rows)
        message(FATAL_ERROR "${_name} trace-row mismatch")
    endif()
    file(SHA256 "${_run}/${_name}.state" _stateHash)
    if(_name STREQUAL "live")
        set(_expectedState "${_stateHash}")
    elseif(NOT _stateHash STREQUAL "${_expectedState}")
        message(FATAL_ERROR "Complete registered checkpoint differs for ${_name}")
    endif()
endforeach()
file(READ "${_run}/live.trace" _liveTrace)
foreach(_name record replay)
    file(READ "${_run}/${_name}.trace" _trace)
    if(NOT _liveTrace STREQUAL _trace)
        message(FATAL_ERROR "Live/${_name} complete per-tick checkpoint hashes differ")
    endif()
endforeach()
file(STRINGS "${_run}/live.trace" _rows)
list(SUBLIST _rows 64 64 _suffixRows)
foreach(_name load seek)
    file(STRINGS "${_run}/${_name}.trace" _trace)
    if(NOT _suffixRows STREQUAL _trace)
        message(FATAL_ERROR "${_name} continuation does not match saved/recorded suffix")
    endif()
endforeach()
file(STRINGS "${_run}/interactive.trace" _interactiveTrace)
list(SUBLIST _interactiveTrace 80 64 _interactiveSuffix)
if(NOT _suffixRows STREQUAL _interactiveSuffix)
    message(FATAL_ERROR "Actual stdin persisted load does not match complete suffix")
endif()
foreach(_file boundary64.dsv interactive64.dsv)
    if(NOT EXISTS "${_run}/${_file}" OR IS_DIRECTORY "${_run}/${_file}" OR IS_SYMLINK "${_run}/${_file}")
        message(FATAL_ERROR "Missing actual persistent save")
    endif()
endforeach()
file(SHA256 "${_run}/boundary64.dsv" _scriptSave)
file(SHA256 "${_run}/interactive64.dsv" _stdinSave)
if(NOT _scriptSave STREQUAL _stdinSave)
    message(FATAL_ERROR "Scripted and actual stdin boundary64 complete save bytes differ")
endif()
message(STATUS "Checkpoint Host: keys/finish, platform contact, actual pause/resume, persistent fresh Host load, Record/Replay/Seek/stdin agree; artifacts ${_run}")
